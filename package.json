    "@supabase/supabase-js": "^2.117.2",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.5",
    "google-auth-library": "^10.9.1",
    "luxon": "^3.7.2",
    "nunjucks": "^3.2.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.20.4",
    "@types/nunjucks": "^3.2.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
